<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:contentDescription="Tutorial 2"
        android:src="@drawable/ic_laundry_basket" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Pantau Status Cucian Realtime"
        android:textColor="#F57F17"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Ketahui apakah pakaian Anda sedang dicuci, dikeringkan, atau siap diambil."
        android:textColor="#795548"
        android:textSize="15sp" />

</LinearLayout>