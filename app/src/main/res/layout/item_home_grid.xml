<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_grid_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ivServiceIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Icon Layanan"
        android:src="@drawable/ic_laundry_basket" />

    <TextView
        android:id="@+id/tvServiceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#212121"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvServiceCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:background="#E3F2FD"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#1976D2"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvServicePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:textColor="#2E7D32"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>