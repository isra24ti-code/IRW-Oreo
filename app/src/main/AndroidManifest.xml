<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin Akses Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IRWOreo">

        <!-- SplashActivity sebagai Launching Activity Utama -->
        <activity
            android:name=".smartlaundry.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Halaman Login -->
        <activity
            android:name=".smartlaundry.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- BaseActivity sebagai Kontainer Utama Dashboard -->
        <activity
            android:name=".BaseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity Pendukung Lainnya -->
        <activity
            android:name=".smartlaundry.DetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".smartlaundry.WebActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".smartlaundry.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Registrasi & Verifikasi -->
        <activity
            android:name=".smartlaundry.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".smartlaundry.VerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Tutorial Onboarding (Message / ViewPager2) -->
        <activity
            android:name=".smartlaundry.tutorial.TutorialMessageActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Pertemuan 10 & 11 (TabLayout, ViewPager2, RecyclerView) -->
        <activity
            android:name=".pertemuan_10.TenthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>